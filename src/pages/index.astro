---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import RecipeCard from '../components/RecipeCard.astro';
import type { RecipeSummary } from '../lib/filter';
import { ingredientText, tipsText } from '../lib/recipe-text';
import { tagUrl, url } from '../lib/url';
import { getRecipes } from '../lib/recipes';
import { allTags } from '../lib/tags';
import '../styles/overview.css';

const recipes = await getRecipes();
// Janitas feste Kategorien erscheinen immer, auch solange noch kein Rezept dazu existiert.
const JANITA_TAGS = ['Healthy', 'Lunch', 'Dinner', 'Dessert', 'Comfort Food', 'Meat Lover', 'Veggie Love', 'Protein Power', 'Hosting'];
const tags = allTags([...recipes.map((r) => r.data.tags), JANITA_TAGS]);
const summaries: RecipeSummary[] = recipes.map((r) => ({
  id: r.id,
  title: r.data.title,
  tags: r.data.tags,
  rating: r.data.rating ?? null,
  duration: r.data.duration ?? null,
  added: r.data.added.toISOString().slice(0, 10),
  ingredients: ingredientText(r.body ?? ''),
  extra: [...r.data.tags, ...r.data.keywords, tipsText(r.body ?? '')].join(' '),
  cooked: r.data.rating !== undefined,
  book: r.data.book,
}));
const ownCount = recipes.filter((r) => r.data.book === 'janita').length;

// Kategorie-Ordner der Startseite: zuerst „Alle“, dann die Kategorien des jeweiligen Buchs.
// Das Ordnerbild zeigt die Fotos der bis zu vier neuesten Rezepte.
const newestFirst = [...recipes].sort((a, b) => b.data.added.getTime() - a.data.added.getTime() || a.data.title.localeCompare(b.data.title, 'de'));
const folderTags = {
  janita: JANITA_TAGS,
  mirco: allTags(recipes.filter((r) => r.data.book === 'mirco').map((r) => r.data.tags)),
};
const folders = (['janita', 'mirco'] as const).flatMap((book) =>
  ['', ...folderTags[book]].map((tag) => {
    const inFolder = newestFirst.filter((r) => r.data.book === book && (tag === '' || r.data.tags.includes(tag)));
    return { book, tag, name: tag || 'Alle', count: inFolder.length, covers: inFolder.flatMap((r) => (r.data.cover ? [r.data.cover] : [])).slice(0, 4) };
  }),
);
// Stichwörter je Buch als Schnellsuche unter dem Suchfeld.
const keywordsOf = (book: 'janita' | 'mirco') =>
  allTags(recipes.filter((r) => r.data.book === book).map((r) => r.data.keywords)).map((keyword) => ({ book, keyword }));
const keywordChips = [...keywordsOf('janita'), ...keywordsOf('mirco')];
const countText = (n: number) => `${n} ${n === 1 ? 'Rezept' : 'Rezepte'}`;
const data = JSON.stringify({ recipes: summaries, tags }).replace(/</g, '\\u003c');
---
<Base title="Janitas RecipeBook" image={new URL(url('icon-512.png'), Astro.site).href} smallCard>
  <h1 class="visually-hidden">Rezepte</h1>
  <section class="controls">
    <div class="controls-row">
      <input type="search" class="search" placeholder="Rezept, Zutat oder Stichwort …" aria-label="Suche" />
    </div>
    {keywordChips.length > 0 && (
      <div class="keyword-chips" aria-label="Stichwörter">
        <a class="tag ideas-link" data-book="janita" href={url('ideen/')}>Ernährungsideen</a>
        {keywordChips.map((k) => <button type="button" class="tag tag-chip keyword-chip" data-book={k.book} data-keyword={k.keyword} hidden={k.book !== 'janita'}>{k.keyword}</button>)}
      </div>
    )}
  </section>
  <ul class="folder-grid">
    {folders.map((f) => (
      <li class="folder" data-book={f.book} data-tag={f.tag} hidden={f.book !== 'janita'}>
        <a href={f.tag ? tagUrl(f.tag, f.book) : url(`?alle=1${f.book === 'mirco' ? '&buch=mirco' : ''}`)}>
          <div class="folder-art">
            {[0, 1, 2, 3].map((i) => (f.covers[i] ? <Image src={f.covers[i]} alt="" widths={[160, 320]} sizes="(max-width: 600px) 22vw, 120px" /> : <span class="folder-empty" />))}
          </div>
          <span class="folder-name">{f.name}</span>
          <span class="folder-count">{countText(f.count)}</span>
        </a>
      </li>
    ))}
  </ul>
  <section class="list-view" hidden>
    <div class="list-head">
      <button type="button" class="back-btn">‹ Kategorien</button>
      <h2 class="list-title">Alle</h2>
    </div>
    <div class="list-tools">
      <button type="button" class="tag tag-chip uncooked-chip" aria-pressed="false">Noch nicht gekocht</button>
      <select class="sort" aria-label="Sortierung">
        <option value="name">Name (A–Z)</option>
        <option value="rating">Bewertung</option>
        <option value="duration">Dauer</option>
        <option value="added">Zuletzt hinzugefügt</option>
      </select>
    </div>
    <p class="result-count" aria-live="polite">{countText(ownCount)}</p>
    <ul class="card-grid">
      {recipes.map((r) => <RecipeCard recipe={r} />)}
    </ul>
    <p class="empty" hidden>Keine Rezepte gefunden.</p>
  </section>
  <p class="empty empty-own" hidden>Noch keine eigenen Rezepte. Schick Claude einfach ein Rezept als Link, Foto oder Text.</p>
  <dialog class="card-menu" aria-labelledby="card-menu-title">
    <form method="dialog" class="card-menu-inner">
      <p class="card-menu-title" id="card-menu-title"></p>
      <div class="card-menu-view" data-view="actions">
        <button type="button" class="menu-btn" data-action="share">Teilen</button>
        <button type="button" class="menu-btn menu-btn--danger" data-action="delete">Löschen</button>
        <button value="cancel" class="menu-btn menu-btn--plain">Abbrechen</button>
      </div>
      <div class="card-menu-view" data-view="confirm" hidden>
        <label class="token-field">
          <span>GitHub-Schlüssel (nur einmal nötig)</span>
          <input type="password" class="token-input" autocomplete="off" spellcheck="false" />
        </label>
        <button type="button" class="menu-btn menu-btn--danger" data-action="confirm-delete">Löschen</button>
        <button value="cancel" class="menu-btn menu-btn--plain">Abbrechen</button>
      </div>
      <p class="card-menu-status" aria-live="polite"></p>
    </form>
  </dialog>
  <script type="application/json" id="recipe-data" set:html={data} />
</Base>
<script>
  import '../scripts/overview';
</script>
