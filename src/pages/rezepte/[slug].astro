---
import { getImage, Image } from 'astro:assets';
import { cookedLabel } from '../../lib/cooked';
import { FAVORITE } from '../../lib/keywords';
import { formatMicro } from '../../lib/micros';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import Stars from '../../components/Stars.astro';
import { getRecipes, type Recipe } from '../../lib/recipes';
import { ingredientLines, ingredientText, stepTexts } from '../../lib/recipe-text';
import { perServingLabel, servingsLabel } from '../../lib/servings-label';
import { tagUrl, url } from '../../lib/url';
import '../../styles/recipe.css';

export async function getStaticPaths() {
  const recipes = await getRecipes();
  return recipes.map((recipe) => ({ params: { slug: recipe.id }, props: { recipe } }));
}

const { recipe } = Astro.props as { recipe: Recipe };
const { Content } = await render(recipe);
const d = recipe.data;
const favorite = d.keywords.includes(FAVORITE);
const subtitle = d.keywords.filter((k) => k !== FAVORITE && !(k === 'Zyklus' && d.zyklus)).join(' · ');
const cookedDays = d.cooked.map((day) => day.toISOString().slice(0, 10));
const sourceIsLink = d.source?.startsWith('http') ?? false;
const ogImage = d.cover ? await getImage({ src: d.cover, width: 1200, format: 'jpeg' }) : null;
const ogImageUrl = ogImage ? new URL(ogImage.src, Astro.site).href : new URL(url('icon-512.png'), Astro.site).href;
const summary = [d.duration ? `${d.duration} Min.` : null, `${d.servings} ${servingsLabel(d.servings, d.servingsLabel)}`].filter(Boolean).join(', ');
const ingredients = ingredientText(recipe.body ?? '');
const description = `Rezept für ${d.title}: ${summary}.${ingredients ? ` Zutaten: ${ingredients}` : ''}`;
const nutrition = [
  { label: 'kcal', value: `${d.nutrition.kcal}` },
  { label: 'Eiweiß', value: `${d.nutrition.protein} g` },
  { label: 'Kohlenhydrate', value: `${d.nutrition.carbs} g` },
  { label: 'Fett', value: `${d.nutrition.fat} g` },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: d.title,
  image: ogImage ? [ogImageUrl] : undefined,
  totalTime: d.duration ? `PT${d.duration}M` : undefined,
  recipeYield: `${d.servings} ${servingsLabel(d.servings, d.servingsLabel)}`,
  recipeCategory: d.tags.join(', ') || undefined,
  recipeIngredient: ingredientLines(recipe.body ?? ''),
  recipeInstructions: stepTexts(recipe.body ?? '').map((text) => ({ '@type': 'HowToStep', text })),
  nutrition: {
    '@type': 'NutritionInformation',
    servingSize: `1 ${perServingLabel(d.servingsLabel)}`,
    calories: `${d.nutrition.kcal} kcal`,
    proteinContent: `${d.nutrition.protein} g`,
    carbohydrateContent: `${d.nutrition.carbs} g`,
    fatContent: `${d.nutrition.fat} g`,
  },
  datePublished: d.added.toISOString().slice(0, 10),
};
---
<Base title={d.title} description={description} image={ogImageUrl} book={d.book}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="recipe" data-recipe-id={recipe.id} data-servings={d.servings} data-servings-label={d.servingsLabel}>
    <div class="recipe-hero">
      {d.cover ? <Image src={d.cover} alt="" widths={[480, 960, 1600]} sizes="(min-width: 1232px) 1232px, 100vw" priority /> : <Placeholder />}
    </div>
    <header class="recipe-header">
      <div class="recipe-title-row">
        <h1>{d.title}</h1>
        <button type="button" class="favorite-btn" data-published={String(favorite)} aria-pressed={String(favorite)} aria-label={favorite ? 'Kein Lieblingsessen mehr' : 'Als Lieblingsessen merken'}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.3 4.6 13a4.9 4.9 0 0 1 0-7 4.9 4.9 0 0 1 7 0l.4.4.4-.4a4.9 4.9 0 0 1 7 0 4.9 4.9 0 0 1 0 7Z" /></svg>
        </button>
      </div>
      {subtitle && <p class="recipe-keywords">{subtitle}</p>}
      {d.zyklus && (
        <p class="recipe-zyklus"><strong>Zyklus · {d.zyklus.phase}:</strong> {d.zyklus.grund}</p>
      )}
      <ul class="recipe-meta">
        {d.duration && <li>⏱ {d.duration} Min.</li>}
        {d.rating && <li><Stars rating={d.rating} /></li>}
        {(d.rating || cookedDays.length > 0) && <li class="cooked">✓ Gekocht</li>}
        {d.book === 'mirco' && <li>Aus Mircos Rezepten</li>}
        {d.source && (
          <li>
            Quelle:{' '}
            {sourceIsLink ? <a href={d.source} target="_blank" rel="noopener">{new URL(d.source).hostname}</a> : d.source}
          </li>
        )}
      </ul>
      <ul class="tag-list">
        {d.tags.map((t) => <li><a class="tag" href={tagUrl(t, d.book)}>{t}</a></li>)}
      </ul>
      <div class="cooked-box" data-published={JSON.stringify(cookedDays)}>
        <button type="button" class="cooked-btn" aria-pressed="false">Heute gekocht</button>
        <button type="button" class="cooked-undo" hidden>Rückgängig</button>
        <span class="cooked-count">{cookedLabel(cookedDays.length)}</span>
      </div>
      <p class="action-status" role="status" hidden></p>
      <section class="nutrition" aria-label="Nährwerte">
        <p class="nutrition-title">Nährwerte pro {perServingLabel(d.servingsLabel)} <span class="nutrition-hint">(ca., geschätzt)</span></p>
        <dl class="nutrition-list">
          {nutrition.map((n) => <div><dt>{n.label}</dt><dd>{n.value}</dd></div>)}
        </dl>
      </section>
      {d.health.length > 0 && (
        <section class="health" aria-label="Gut für">
          <p class="nutrition-title">Gut für</p>
          <ul class="health-list">
            {d.health.map((h) => {
              const i = h.indexOf(':');
              return i > 0 ? <li><strong>{h.slice(0, i)}:</strong>{h.slice(i + 1)}</li> : <li>{h}</li>;
            })}
          </ul>
          {d.micros.length > 0 && (
            <>
              <p class="nutrition-title micros-title">Top-Vitalstoffe pro {perServingLabel(d.servingsLabel)} <span class="nutrition-hint">(ca., Anteil am Tagesbedarf einer Frau)</span></p>
              <ul class="micros-list">
                {d.micros.map(formatMicro).map((m) => (
                  <li>
                    <span class="micro-name">{m.label}</span>
                    <span class="micro-value">{m.value}</span>
                    <span class="micro-bar" aria-hidden="true"><span style={`width: ${Math.min(m.percent, 100)}%`} /></span>
                    <span class="micro-percent">{m.percent} %</span>
                  </li>
                ))}
              </ul>
            </>
          )}
        </section>
      )}
    </header>
    <div class="recipe-toolbar">
      <div class="servings" role="group" aria-label="Portionen">
        <button type="button" class="servings-btn" data-step="-1" aria-label="Eine Portion weniger">−</button>
        <span class="servings-value"><output class="servings-count">{d.servings}</output> <span class="servings-label">{servingsLabel(d.servings, d.servingsLabel)}</span></span>
        <button type="button" class="servings-btn" data-step="1" aria-label="Eine Portion mehr">+</button>
        <button type="button" class="servings-reset" hidden>Zurücksetzen</button>
      </div>
      <label class="wake-lock" hidden><input type="checkbox" class="wake-lock-input" autocomplete="off" /> Bildschirm an</label>
      <button type="button" class="checks-reset" hidden>Häkchen zurücksetzen</button>
    </div>
    <div class="recipe-body">
      <Content />
    </div>
  </article>
  <dialog class="lightbox" aria-label="Bild vergrößert"></dialog>
  <dialog class="card-menu token-dialog" aria-labelledby="token-dialog-title">
    <form method="dialog" class="card-menu-inner">
      <p class="card-menu-title" id="token-dialog-title">{d.title}</p>
      <div class="card-menu-view">
        <label class="token-field">
          <span>GitHub-Schlüssel (nur einmal nötig)</span>
          <input type="password" class="token-input" autocomplete="off" spellcheck="false" />
        </label>
        <button type="button" class="menu-btn menu-btn--primary" data-action="confirm-token">Speichern</button>
        <button value="cancel" class="menu-btn menu-btn--plain">Abbrechen</button>
      </div>
      <p class="card-menu-status" aria-live="polite"></p>
    </form>
  </dialog>
</Base>

<script>
  import '../../scripts/recipe-page';
</script>
