---
import '../styles/global.css';
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Kleines Vorschaubild, z. B. für das quadratische App-Icon. */
  smallCard?: boolean;
  /** Aktives Rezeptbuch im Umschalter oben. */
  book?: 'janita' | 'mirco';
}
const { title, description = 'Meine Rezeptsammlung', image, smallCard = false, book = 'janita' } = Astro.props;
const pageTitle = title === 'Janitas RecipeBook' ? title : `${title} · Janitas RecipeBook`;
const pageUrl = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).href;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={pageUrl} />
    <meta name="description" content={description} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <link rel="icon" href={url('icon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Rezepte" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Janitas RecipeBook" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image && !smallCard ? 'summary_large_image' : 'summary'} />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
      // Parameter vom Aktualisieren-Knopf wieder aus der Adresse entfernen.
      try {
        const u = new URL(location.href);
        if (u.searchParams.has('neu')) {
          u.searchParams.delete('neu');
          history.replaceState(history.state, '', u.pathname + u.search + u.hash);
        }
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href={url('')} aria-label="Startseite: Janitas RecipeBook">
        <svg class="home-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5" /><path d="M5 9.5V20a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9.5" /></svg>
        <span>Janitas RecipeBook</span>
      </a>
      <div class="header-actions">
        <button class="refresh-btn" type="button" aria-label="Aktualisieren" title="Aktualisieren">↻</button>
        <button class="theme-toggle" type="button" aria-label="Dunkles Design" aria-pressed="false">◐</button>
      </div>
    </header>
    <nav class="book-switch" aria-label="Rezeptbuch">
      <a class="book-btn" data-book="janita" href={url('')} aria-current={book === 'janita' ? 'page' : undefined}>Janitas Rezepte</a>
      <a class="book-btn" data-book="mirco" href={url('?buch=mirco')} aria-current={book === 'mirco' ? 'page' : undefined}>Mircos Rezepte</a>
    </nav>
    <main class="page">
      <slot />
    </main>
    <script>
      import '../scripts/theme';
      import '../scripts/refresh';
    </script>
  </body>
</html>
